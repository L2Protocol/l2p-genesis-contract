# Settings for scripts/create-validator. Copy this file to .env next to it and
# fill it in; .env is gitignored, so never commit a real key.
#
#   cp scripts/create-validator/.env.example scripts/create-validator/.env

# --- connection ---------------------------------------------------------

# JSON-RPC endpoint to broadcast through. Falls back to the repo root .env,
# and then to https://rpc01.l2protocol.com.
RPC_L2P=http://127.0.0.1:8545

# Chain id the BLS proof was generated for. The script refuses to send if the
# node reports a different chain id, because the proof is bound to it.
CHAIN_ID=12216

# --- operator -----------------------------------------------------------

# The operator address is derived from this key and becomes the owner of the
# validator, so it must be the same address that was passed to
# `geth bls account generate-proof`.
OPERATOR_PRIVATE_KEY=

# --- validator ----------------------------------------------------------

# Consensus (block sealing) address of the node. May equal the operator
# address, but a separate key is strongly recommended.
VALIDATOR_CONSENSUS_ADDRESS=

# BLS vote address, 48 bytes:
#   geth bls account new  --datadir ./bls --blspassword ./bls-password.txt
#   geth bls account list --datadir ./bls --blspassword ./bls-password.txt
VALIDATOR_VOTE_ADDRESS=

# BLS ownership proof, 96 bytes:
#   geth bls account generate-proof --datadir ./bls --blspassword ./bls-password.txt \
#        --chain-id 12216 <operator address> <BLS pubkey>
VALIDATOR_BLS_PROOF=

# 3-9 characters, first one uppercase A-Z, the rest alphanumeric. Must be
# unique across the chain.
VALIDATOR_MONIKER=

# Optional, free-form.
VALIDATOR_IDENTITY=
VALIDATOR_WEBSITE=
VALIDATOR_DETAILS=

# --- commission ---------------------------------------------------------

# Basis points, 10000 = 100%. Rules: max rate <= 5000, rate <= max rate,
# max change rate <= max rate. Defaults: 500 / 3000 / 500.
VALIDATOR_COMMISSION_RATE=500
VALIDATOR_COMMISSION_MAX_RATE=3000
VALIDATOR_COMMISSION_MAX_CHANGE_RATE=500

# --- optional overrides -------------------------------------------------

# Self delegation in whole L2P. Leave empty to read minSelfDelegationL2P()
# from the chain and stake exactly that minimum. The 3500 L2P lock amount is
# added on top automatically.
VALIDATOR_SELF_DELEGATION=

# Leave empty to use the gas estimate plus a 25% margin.
GAS_LIMIT=

# In gwei. Leave empty to use the fee the node suggests.
MAX_FEE_PER_GAS=
MAX_PRIORITY_FEE_PER_GAS=
